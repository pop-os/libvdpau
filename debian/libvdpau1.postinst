#!/bin/sh
# postinst script for libvdpau1

set -e


if [ "$1" = "configure" ]; then
	# <target: squeeze>
	if [ -L /usr/lib/libvdpau_trace.so ]; then
		rm /usr/lib/libvdpau_trace.so || true
	fi
	# </target: squeeze>
fi

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
